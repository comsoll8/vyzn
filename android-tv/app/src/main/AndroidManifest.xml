<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Not required=true: this installs on a phone/tablet/emulator for
         testing too, but still shows up properly in the Android TV /
         Google TV launcher's app row (via the LEANBACK_LAUNCHER intent
         filter below) when installed on real TV hardware. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Vyzn">

        <!-- screenOrientation is "unspecified" (follows the device/sensor)
             rather than a hard "landscape" lock: a real TV box has no
             rotation sensor and its launcher only ever runs apps in
             landscape anyway, so this activity still only ever renders
             landscape there — but on a phone/tablet it now lets the
             person rotate to portrait, which is what MainActivity.kt's
             isTelevision() check (configureWebView()) uses to decide
             whether to apply the TV web layout or the site's existing
             mobile-responsive one. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Vyzn">

            <!-- Phone/tablet/emulator launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV / Google TV launcher row -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Native (ExoPlayer) playback — launched only from within the app
             via NativePlayerBridge, never from outside, hence exported=false. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Vyzn" />
    </application>
</manifest>
